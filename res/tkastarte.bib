@inproceedings{Astarte2026HI,
	address = {New York, NY, USA},
	articleno = {8},
	author = {Astarte, Troy},
	booktitle = {Heritage Insights 2022 Online Seminar},
	doi = {10.1145/3686262.3686270},
	isbn = {9798400729218},
	location = {Online Seminar},
	numpages = {12},
	publisher = {Association for Computing Machinery},
	series = {Heritage Insights '22},
	title = {Panel 2: Making History Accessible},
	url = {https://doi.org/10.1145/3686262.3686270},
	year = {2026},
	abstract = {Troy Astarte frames the thematic focus of the panel Making History Accessible by reflecting on their experiences as a producer, curator, and user of historical material in computing. Astarte explores multiple dimensions of accessibility: material safekeeping against loss or environmental threat, the reach and usability of historical artifacts, and the importance of appropriate contexts and metadata for enabling effective research. Astarte draws from personal examples involving archives ranging from the Newcastle and Swansea University computing collections to the Bodleian Library and online resources, illustrating both the challenges and practical strategies for safeguarding and sharing computing's historical records. They emphasize the trade-offs between physical and digital accessibility, the impact of embargoes and privacy on archival openness, and the need for both structured metadata and opportunities for serendipitous discovery. Using the case study of the Formal Language Description Languages conference, Astarte demonstrates how the synthesis of conference proceedings, archives, interviews, and related documentation can enrich historical understanding. The introduction sets the stage for panel discussions about the best practices, tools, and policies required to make ACM's heritage --- and computing history more broadly --- both secure and genuinely accessible for future scholarship and public engagement. In the Q&A session that ends this panel, participants address practical challenges in scaling, funding, and documenting ACM SIG archives, highlighting best practices for record-keeping, automation, and legal compliance to enhance heritage accessibility.}}

